# =============================================================================
# DonjonDocs PRODUCTION Environment Configuration (Render + Supabase)
# =============================================================================
# Set these as environment variables in Render's dashboard
# (Service → Environment → Add Environment Variable). Do NOT commit a
# filled-in copy of this file — it contains secrets.
#
# All values below are placeholders; replace them per the deployment guide.
# =============================================================================

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_STRING

# Separate secret for NiceGUI session storage. Generate independently of
# SECRET_KEY so a compromise of one does not invalidate the other.
# (Requires the small main.py change documented in the deployment notes.)
STORAGE_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_STRING

# Token lifetime in minutes. 30 is the default; lower it if you accept
# the UX cost of more frequent re-auth.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database (Supabase Postgres via asyncpg) ---
# Format must use the asyncpg driver and require SSL.
# Replace the host, project id, and password placeholders.
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_ID:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?ssl=require

# --- Auth ---
# Set to false once you have your initial admin account, to prevent
# anonymous account creation.
ALLOW_REGISTRATION=false

# --- App ---
APP_NAME=DonjonDocs

# CRITICAL: must be false in production. Controls SQL echo and the
# Secure cookie flag (see app/auth_cookie.py).
DEBUG=false

# --- Security headers ---
# Enable HSTS only behind HTTPS. Render terminates TLS at the edge,
# so this is correct for Render deploys.
HSTS_ENABLED=true

# --- Trusted hosts (REQUIRES the main.py / config.py change below) ---
# Comma-separated list of hostnames the app will accept in the Host header.
# Replace donjondocs-abcd.onrender.com with your actual Render URL, and
# add your custom domain if you bind one.
ALLOWED_HOSTS=donjondocs-abcd.onrender.com,donjondocs.example.com
