# =============================================================================
# DonjonDocs Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — it contains secrets.
# =============================================================================

# --- Security ---
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-64-char-string
# Independent secret for NiceGUI session storage (must differ from SECRET_KEY).
STORAGE_SECRET=change-me-to-a-different-random-64-char-string

# --- Database ---
# SQLite for local dev (async driver):
DATABASE_URL=sqlite+aiosqlite:///./donjondocs.db
# PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/donjondocs

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOW_REGISTRATION=true

# --- App ---
APP_NAME=DonjonDocs
DEBUG=true

# --- Trusted hosts ---
# Comma-separated. Dev default keeps localhost reachable.
ALLOWED_HOSTS=localhost,127.0.0.1
